      "target_shape": "{ contradictions: [ { memory_id, contradicts_memory_id, basis, confidence } ] }"
    },
    {
      "family": "summarisation",
      "reason": "Consolidation concatenates source content rather than compressing it. There is no summariser to score, so compression ratio is reported instead and is expected to exceed 1.0.",
