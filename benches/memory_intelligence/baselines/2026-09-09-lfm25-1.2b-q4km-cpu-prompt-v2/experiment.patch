diff --git a/.github/workflows/memory-intelligence-prompt-v2-diagnostic.yml b/.github/workflows/memory-intelligence-prompt-v2-diagnostic.yml
new file mode 100644
index 0000000..ca7aa6b
--- /dev/null
+++ b/.github/workflows/memory-intelligence-prompt-v2-diagnostic.yml
@@ -0,0 +1,89 @@
+name: Prompt v2 local-model diagnostic
+
+on:
+  push:
+    branches: [agent/memory-intelligence-prompt-v2]
+
+permissions:
+  contents: read
+
+jobs:
+  diagnostic:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 40
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
+        with:
+          persist-credentials: false
+      - uses: dtolnay/rust-toolchain@6bed0761d98439e5a578e2877258200ad565ba87 # stable
+      - name: Validate pinned inputs
+        id: pin
+        run: |
+          python3 - <<'PY'
+          import os
+          from pathlib import Path
+          from urllib.parse import quote
+          from benches.memory_intelligence import evaluate, local_baseline
+          pin = evaluate.load_json(Path('benches/memory_intelligence/local-baseline.pin.json'))
+          local_baseline.validate_pin(pin)
+          model = pin['model']
+          assert pin['runtime']['repository'] == 'ggml-org/llama.cpp'
+          assert model['repository'] == 'LiquidAI/LFM2.5-1.2B-Instruct-GGUF'
+          url = 'https://huggingface.co/' + model['repository'] + '/resolve/' + model['revision'] + '/' + quote(model['filename'], safe='')
+          with open(os.environ['GITHUB_OUTPUT'], 'a') as output:
+              output.write('runtime_revision=' + pin['runtime']['revision'] + '\n')
+              output.write('model_url=' + url + '\n')
+          PY
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
+        with:
+          repository: ggml-org/llama.cpp
+          ref: ${{ steps.pin.outputs.runtime_revision }}
+          path: .baseline/llama.cpp
+          persist-credentials: false
+      - name: Build MAG producer and pinned CPU server
+        run: |
+          set -euo pipefail
+          cargo build --locked --release --features llm
+          cmake -S .baseline/llama.cpp -B .baseline/llama.cpp/build \
+            -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF \
+            -DLLAMA_BUILD_TESTS=OFF -DLLAMA_BUILD_EXAMPLES=OFF \
+            -DLLAMA_BUILD_APP=OFF -DLLAMA_BUILD_SERVER=ON \
+            -DLLAMA_BUILD_UI=OFF -DLLAMA_USE_PREBUILT_UI=OFF -DLLAMA_OPENSSL=OFF
+          cmake --build .baseline/llama.cpp/build --parallel 4 --target llama-server
+      - name: Download pinned model
+        env:
+          MODEL_URL: ${{ steps.pin.outputs.model_url }}
+        run: |
+          curl --fail --location --proto '=https' --proto-redir '=https' \
+            --connect-timeout 20 --max-time 600 --retry 2 \
+            "$MODEL_URL" --output "$RUNNER_TEMP/model.gguf"
+      - name: Capture and score prompt v2 once
+        run: |
+          set -euo pipefail
+          mkdir -p "$RUNNER_TEMP/prompt-v2-evidence"
+          python3 benches/memory_intelligence/local_baseline.py \
+            benches/memory_intelligence/dataset.v1.json \
+            --pin benches/memory_intelligence/local-baseline.pin.json \
+            --mag "$PWD/target/release/mag" \
+            --server "$PWD/.baseline/llama.cpp/build/bin/llama-server" \
+            --model "$RUNNER_TEMP/model.gguf" --code-revision "$(git rev-parse HEAD)" \
+            --startup-timeout 180 --case-timeout 90 --threads 2 \
+            --output "$RUNNER_TEMP/prompt-v2-evidence/run.json"
+          python3 benches/memory_intelligence/evaluate.py score \
+            benches/memory_intelligence/dataset.v1.json \
+            "$RUNNER_TEMP/prompt-v2-evidence/run.json" \
+            --output "$RUNNER_TEMP/prompt-v2-evidence/scorecard.json"
+      - name: Record context
+        if: always()
+        run: |
+          mkdir -p "$RUNNER_TEMP/prompt-v2-evidence"
+          lscpu --json > "$RUNNER_TEMP/prompt-v2-evidence/cpu.json"
+          { git rev-parse HEAD; rustc --version; cmake --version; c++ --version; } > "$RUNNER_TEMP/prompt-v2-evidence/toolchain.txt"
+          cp benches/memory_intelligence/local-baseline.pin.json "$RUNNER_TEMP/prompt-v2-evidence/pin.json"
+      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
+        if: always()
+        with:
+          name: prompt-v2-local-diagnostic-${{ github.sha }}
+          path: ${{ runner.temp }}/prompt-v2-evidence/
+          if-no-files-found: error
+          retention-days: 3
diff --git a/meta/contracts/memory.models.md b/meta/contracts/memory.models.md
index f77c81e..61a5813 100644
--- a/meta/contracts/memory.models.md
+++ b/meta/contracts/memory.models.md
@@ -44,0 +45,9 @@ errors crossing this boundary are redacted, without retries or fallback.
+Prompt version 2 presents the already validated answer-blind request as explicit
+task, instruction, and source sections rather than as one serialized JSON user
+message. The system message states the exact result schema, treats source text as
+evidence rather than instructions, requires the instruction's canonical value
+format and complete source provenance, and permits an empty `items` array only
+when no supplied source supports a valid item. This is prompt framing only: case
+IDs, expected answers, dataset metadata, storage state, and scorer information
+remain unavailable to the model.
+
