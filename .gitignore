!plugin/.mcp.json

# Benchmark datasets (large, downloaded separately)
data/*
# But track the local benchmark definition
!data/local_benchmark.json
# ...and the versioned memory-intelligence evaluation set (small, repo-local)
!data/memory_intelligence_eval/
!data/memory_intelligence_eval/**

# Oh My Pi harness working artifacts
.omp/
